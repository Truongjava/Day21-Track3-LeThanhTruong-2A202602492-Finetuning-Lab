# Python
__pycache__/
*.py[cod]
.venv*/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
# notebooks/*.py (jupytext) is the source of truth and IS committed.
# colab/*.ipynb is generated and IS committed (students launch from it).

# Lab artifacts — regenerated by the notebooks, never committed
adapters/*/
!adapters/.gitkeep
data/split/
data/CUSTOM_DATASET.md
results/*.json
results/*.csv
!results/.gitkeep
gguf/
*.gguf
runs/
wandb/

# Model / HF cache
.cache/
hf_cache/

# The submission itself: unpacked `lab21_<MSSV>.zip`. Holds the trained adapter
# (adapter_model.safetensors is ~124 MB, past GitHub's 100 MB per-file ceiling) and it
# is assembled from results/ + adapters/, both ignored above. Zip it to hand in; it is
# not source, and a push that includes it is rejected by the remote.
lab21_*/
*.zip

# Secrets
.env
.env.local
*.token

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
